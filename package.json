  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && rolldown -c --configLoader native",
    "prepare": "npm run build",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p src/client && vitest run",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "test": "vitest run",
    "watch:client": "rolldown -c --configLoader native --watch"
  }
